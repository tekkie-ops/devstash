# Neon PostgreSQL — pooled connection, used by the app at runtime
DATABASE_URL=""

# Neon PostgreSQL — direct (unpooled) connection, used by the Prisma CLI for migrations
DATABASE_URL_UNPOOLED=""

# NextAuth — random secret used to sign/encrypt tokens (generate with `npx auth secret`)
AUTH_SECRET=""

# GitHub OAuth app credentials
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Resend — used to send the email verification link on registration
RESEND_API_KEY=""

# Set to "false" to skip the email verification requirement on registration
# (useful until a domain is linked to Resend, since its sandbox sender can
# only deliver to the Resend account's own email). Defaults to enabled.
EMAIL_VERIFICATION_ENABLED="true"

# Upstash Redis — used to rate limit auth endpoints (login, register,
# forgot-password, reset-password, resend-verification). Rate limiting
# fails open (allows the request) if these are unset.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare R2 — stores uploaded file/image items. The account ID + access
# key/secret let the server PUT/GET/DELETE objects (S3 API); R2_PUBLIC_URL is
# the bucket's public dev/custom domain used to build the stored file URL.
# Uploads are disabled (503) if R2_BUCKET_NAME is unset.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
